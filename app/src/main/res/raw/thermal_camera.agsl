uniform shader camera;
uniform float strength;

float luminance(half4 pixel) {
    return dot(float3(pixel.rgb) / max(float(pixel.a), 0.001), float3(0.2126, 0.7152, 0.0722));
}

float3 thermalPalette(float value) {
    float3 color = mix(float3(0.02, 0.025, 0.18), float3(0.05, 0.25, 0.95), smoothstep(0.0, 0.25, value));
    color = mix(color, float3(0.8, 0.04, 0.45), smoothstep(0.2, 0.5, value));
    color = mix(color, float3(1.0, 0.3, 0.04), smoothstep(0.45, 0.72, value));
    return mix(color, float3(1.0, 0.98, 0.55), smoothstep(0.68, 1.0, value));
}

half4 main(float2 position) {
    half4 original = camera.eval(position);
    float light = luminance(original);
    float edge = abs(light - luminance(camera.eval(position + float2(2.0, 0.0))))
               + abs(light - luminance(camera.eval(position + float2(0.0, 2.0))));
    float3 color = thermalPalette(clamp(pow(light, 0.7), 0.0, 1.0));
    color += float3(0.1, 0.2, 0.18) * smoothstep(0.03, 0.2, edge);
    color *= 0.97 + 0.03 * sin(position.y * 1.5);
    half4 filtered = half4(half3(clamp(color, 0.0, 1.0)) * original.a, original.a);
    return mix(original, filtered, half(strength));
}
